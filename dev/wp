#!/bin/sh
# 開発環境の wp-cli。ブランチのサイトとして動かすなら HEIMDB_SITE_DB=wordpress@staging（root でつなぐ）。
cd "$(dirname "$0")" || exit 1
if [ -n "$HEIMDB_SITE_DB" ]; then
  exec docker compose run --rm -T -e WORDPRESS_DB_NAME="$HEIMDB_SITE_DB" -e WORDPRESS_DB_USER=root -e WORDPRESS_DB_PASSWORD=root-secret cli wp "$@"
fi
exec docker compose run --rm -T cli wp "$@"
