#. Plugin Name of the plugin
#: heimdb.php
#: includes/class-admin.php:1410
msgid "HeimDB"
msgstr "HeimDB"

#. Description of the plugin
#: heimdb.php
msgid "Branches, diffs, conflict resolution, merges, time travel and restores of HeimDB, from wp-admin and wp-cli."
msgstr "HeimDB のブランチ、差分、競合の解決、マージ、タイムトラベルと復元を、管理画面と wp-cli から操作します。"

#. Author of the plugin
#: heimdb.php
msgid "Tsukinowa Inc."
msgstr "Tsukinowa Inc."

#. translators: %s: branch name
#: heimdb.php:54
#, php-format
msgid "HeimDB branch: %s"
msgstr "HeimDB のブランチ: %s"

#: includes/class-admin.php:35
#: includes/class-admin.php:382
#: includes/class-admin.php:1410
msgid "Branches"
msgstr "ブランチ"

