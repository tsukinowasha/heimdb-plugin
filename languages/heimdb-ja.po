#, php-format
msgid "Forked at %1$s · database %2$s · %3$s"
msgstr "%1$s に分岐 · データベース %2$s · %3$s"

#: includes/class-admin.php:496
msgid "Changes to merge"
msgstr "マージする変更"

#: includes/class-admin.php:498
