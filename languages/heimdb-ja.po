msgid "Show every row"
msgstr "すべての行を表示"

#: includes/class-admin.php:516
msgid "Merge"
msgstr "マージ"

#. translators: %d: number of conflicts
#: includes/class-admin.php:519
#, php-format
msgid "%d unresolved conflict. Decide which side to keep for each row before merging."
msgid_plural "%d unresolved conflicts. Decide which side to keep for each row before merging."
msgstr[0] "解決していない競合が %d 件あります。マージの前に、行ごとにどちらの側を採るかを決めてください。"

#: includes/class-admin.php:520
msgid "Review conflicts"
msgstr "競合を確認"

#: includes/class-admin.php:523
msgid "Keep the branch for all"
msgstr "すべてブランチの側を採る"

#: includes/class-admin.php:524
msgid "Keep the parent for all"
msgstr "すべて親の側を採る"

#. translators: %d: number of conflicts
#: includes/class-admin.php:529
#, php-format
msgid "%d conflict resolved."
msgid_plural "%d conflicts resolved."
msgstr[0] "%d 件の競合を解決済みです。"

#: includes/class-admin.php:537
msgid "The merge is a single commit; on failure nothing is written. Writes to the parent wait while it runs. Comments and users stay as they are on the parent."
msgstr "マージは 1 つのコミットで、失敗すれば何も書き込みません。マージの間、親への書き込みは待たされます。コメントとユーザーは親のまま残ります。"

#: includes/class-admin.php:541
#: includes/class-admin.php:568
msgid "Dry run"
msgstr "空打ち"

#. translators: 1: branch, 2: parent
#: includes/class-admin.php:542
#, php-format
msgid "Merge %1$s into %2$s?"
msgstr "%1$s を %2$s にマージしますか？"

#. translators: %s: parent
#: includes/class-admin.php:545
#, php-format
msgid "Merge into %s"
msgstr "%s にマージ"

#: includes/class-admin.php:578
