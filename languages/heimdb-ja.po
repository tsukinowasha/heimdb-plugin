#. Plugin Name of the plugin
#: heimdb.php
#: includes/class-admin.php:1392
msgid "HeimDB"
msgstr "HeimDB"

#. Plugin URI of the plugin
#: heimdb.php
msgid "https://github.com/tsukinowasha/heimdb"
msgstr "https://github.com/tsukinowasha/heimdb"

#. Description of the plugin
#: heimdb.php
msgid "Branches, diffs, conflict resolution, merges, time travel and restores of HeimDB, from wp-admin and wp-cli."
msgstr "HeimDB のブランチ、差分、競合の解決、マージ、時間旅行と復元を、管理画面と wp-cli から操作します。"

#. Author of the plugin
#: heimdb.php
msgid "Tsukinowa Inc."
msgstr "Tsukinowa Inc."

#. translators: %s: branch name
#: heimdb.php:54
#, php-format
msgid "HeimDB branch: %s"
msgstr "HeimDB のブランチ: %s"

#: includes/class-admin.php:35
#: includes/class-admin.php:372
#: includes/class-admin.php:1392
msgid "Branches"
msgstr "ブランチ"

