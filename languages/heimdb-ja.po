msgstr "この表だけを戻すなら、%1$s を %2$s に復元する下見をしてください。"

#: includes/class-admin.php:1029
msgid "Preview"
msgstr "下見"

#: includes/class-admin.php:1036
msgid "Branch off from this point"
msgstr "この時点からブランチを作成"

#. translators: 1: branch, 2: time
#: includes/class-admin.php:1038
#, php-format
msgid "Creates a new branch with %1$s as it was at %2$s, without changing %1$s. Useful to look around or to take data back by merging."
msgstr "%2$s の時点の %1$s から新しいブランチを作ります。%1$s は変わりません。当時の状態を見て回るときや、データをマージで取り戻すときに使えます。"

#: includes/class-admin.php:1049
msgid "HeimDB status"
msgstr "HeimDB の状態"

#: includes/class-admin.php:1069
msgid "None yet."
msgstr "まだありません。"

#: includes/class-admin.php:1076
msgid "Server"
msgstr "サーバ"

#: includes/class-admin.php:1067
#: includes/class-admin.php:1087
msgid "Tables excluded from merges"
msgstr "マージから外す表"

#: includes/class-admin.php:1088
msgid "Rebuildable tables such as search indexes (e.g. wp_yoast_%). Merges leave them as they are on the parent."
msgstr "検索の索引など、作り直せる表（例: wp_yoast_%）。マージでは親の表をそのまま残します。"

#: includes/class-admin.php:1095
msgid "Remove"
msgstr "外す"

#: includes/class-admin.php:1100
msgid "Exclude"
msgstr "マージから外す"

#: includes/class-admin.php:1103
msgid "Backup"
msgstr "バックアップ"

#: includes/class-admin.php:1104
